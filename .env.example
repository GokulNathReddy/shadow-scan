# ─── ShadowScan Environment Variables ───
# Copy this file to .env and fill in your API keys,
# or paste the key in the app under Diagnostics → AbuseIPDB API Key.

# AbuseIPDB API key (only needed for the IP Reputation module)
# Sign up for free at: https://www.abuseipdb.com/account/api
ABUSEIPDB_KEY=your_api_key_here
